PORT=8000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
IRSA_SIA_URL=https://irsa.ipac.caltech.edu/SIA
IRSA_ALLOWED_HOST=irsa.ipac.caltech.edu
IRSA_DEFAULT_COLLECTION=spherex_qr3
IRSA_SIA_MAXREC=5000
IRSA_SIA_TIMEOUT_SECONDS=30
IRSA_CUTOUT_TIMEOUT_SECONDS=60
IRSA_MAX_RETRIES=1
IRSA_MAX_CUTOUT_BYTES=104857600
HTTP_USER_AGENT=sphereye/0.1 (+hackathon)
MAX_CONCURRENT_RENDERS=4
RENDER_QUEUE_TIMEOUT_SECONDS=30
VISIT_GAP_DAYS=2.0
FLAGS_REJECT_NAMES=NONFUNC,MISSING_DATA,HOT,COLD,OVERFLOW,SUR_ERROR,PHANMISS
APP_VERSION=0.1.0
# Container only (not read by the app): number of uvicorn workers
# WEB_CONCURRENCY=1
MAX_OUTPUT_EDGE_PX=4096
CUTOUT_FETCH_CONCURRENCY=3
STACK_MAX_EXPOSURES=8
MAX_CUTOUTS_PER_REQUEST=12
MAX_FETCH_PIXELS_PER_REQUEST=16646400

# --- Cache / Storage (spec-infrastructure-spherex-image-cache, 4.6) ---------------------
# All values below are placeholders. Never commit real credentials.
# Without CACHE_ENABLED=true no S3_* variable is required.
CACHE_ENABLED=false
# Endpoint of the S3-compatible API (R2 example; account id is a placeholder)
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sphereye
S3_ACCESS_KEY_ID=example-access-key-id
S3_SECRET_ACCESS_KEY=example-secret-access-key
S3_ADDRESSING_STYLE=path
# when_required or when_supported (see README, R2-03)
S3_CHECKSUM_MODE=when_required
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=20
# Total attempts = S3_MAX_ATTEMPTS + 1 with botocore "standard" mode
S3_MAX_ATTEMPTS=3
S3_MAX_POOL_CONNECTIONS=20
# Public URL of the bucket: https, no query string, no trailing slash
S3_PUBLIC_BASE_URL=https://pub-0000000000000000.r2.dev
# Separates environments in the same bucket; must end with "/" when not empty
S3_KEY_PREFIX=dev/
# Public URL of this API (used by response_format=json/redirect when the cache is bypassed)
API_PUBLIC_BASE_URL=http://localhost:8000
POSITION_QUANTUM_ARCSEC=6.15
SIA_CACHE_TTL_SECONDS=21600
IMAGE_META_L1_TTL_SECONDS=3600
MEMORY_CACHE_MAX_ITEMS=512
STORAGE_CIRCUIT_OPEN_SECONDS=60
